# Exact Docker names are derived from this prefix.
VOCA_STACK_NAME=voca
VOCA_RELEASE=local
VOCA_SITE_URL=https://voca.sethmccarthy.in
VOCA_BIND_ADDRESS=127.0.0.1
VOCA_HTTP_PORT=8088
VOCA_ADMIN_PORT=8001

# Generated by init-env.mjs. Never commit the resulting .env.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
DASHBOARD_USERNAME=voca
DASHBOARD_PASSWORD=

# Existing provider keys can be copied from api/.env by init-env.mjs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
UNSPLASH_ACCESS_KEY=

# Enable new signups only after configuring and verifying SMTP.
# Existing imported users can still sign in while signup is disabled.
DISABLE_SIGNUP=true
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
