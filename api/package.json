{
  "name": "voca-server",
  "version": "1.0.0",
  "private": true,
  "description": "Voca — backend API.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
