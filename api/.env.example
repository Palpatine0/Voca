# Server runtime
PORT=4000
HOST=0.0.0.0

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Must match the bucket created by the storage migration.
SUPABASE_STORAGE_BUCKET=voca-media

# Word enrichment
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Production audio routing (server-only; leave unset for direct local requests).
# Vercel holds the same relay secret and ELEVENLABS_API_KEY.
# VOCA_AUDIO_RELAY_URL=https://voca0.vercel.app/api/pronunciation
# VOCA_AUDIO_RELAY_SECRET=generate-at-least-32-random-characters
