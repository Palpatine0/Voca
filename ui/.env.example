# Local web/iOS simulator. Use your computer's LAN IP for a physical device,
# or http://10.0.2.2:4000 for the standard Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Use the same Supabase project as api/.env. Only the public anon key belongs here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
