    "test:review": "jest --runInBand tests/review.test.tsx tests/pronunciation.test.tsx",
    "test:offline": "jest --runInBand tests/audio.test.ts tests/deck.test.ts tests/offline-ui.test.tsx tests/api.test.ts",
    "test:ocr": "jest --runInBand tests/photo.test.ts tests/photo-import.test.tsx",
    "test:library": "jest --runInBand tests/library.test.tsx tests/deck.test.ts tests/audio.test.ts tests/api.test.ts",
    "assets:generate": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
