{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/pronunciation",
      "destination": "/api/pronunciation"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "functions": {
    "api/pronunciation.js": {
      "maxDuration": 30
    }
  }
}
